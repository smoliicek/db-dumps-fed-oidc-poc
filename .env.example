# Copy to .env and fill in. Never commit .env.

# Hatlas Keycloak realm
KC_REALM_URL=https://auth.hatlas.mwinters.net/realms/hatlas

# Confidential client used by Apache for browser login + token introspection
OIDC_CLIENT_ID=db-dumps
OIDC_CLIENT_SECRET=<from Keycloak: Clients -> db-dumps -> Credentials>

# Encrypts mod_auth_openidc session/state cookies. Generate with: openssl rand -base64 32
OIDC_CRYPTO_PASSPHRASE=<random>

# Where the browser reaches Apache (must match the redirect URI registered on the db-dumps client)
PUBLIC_BASE_URL=http://localhost:8081

# FAS group required for access (flat name, as it appears in the token's "groups" claim)
REQUIRED_GROUP=<your test group>
